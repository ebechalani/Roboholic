rules_version = '2';

// ============================================================
//  RoboHolic Firestore Security Rules
//  - Curriculum content (programs, courses, lessons...) is world-readable.
//  - Writes to curriculum require an admin or coach role.
//  - Per-user data (progress, submissions) is owner-scoped.
//  Role is stored on the user's profile doc: /users/{uid}.role
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function userRole() {
      return isSignedIn() ? me().role : 'guest';
    }
    // Missing status = legacy account = approved.
    function isApprovedAccount() {
      return isSignedIn() && (!('status' in me()) || me().status == 'approved');
    }
    function isAdmin() { return userRole() == 'admin'; }
    // Coaches only count once the admin has APPROVED them.
    function isCoach() { return (userRole() == 'coach' && isApprovedAccount()) || isAdmin(); }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    // The ROOT admin (academy director) — the only account allowed to
    // grant/remove admin rights, and which can never be demoted.
    function isRootAdmin() {
      return isSignedIn() && request.auth.token.email == 'ebechalani@gmail.com';
    }

    // ── Reference / curriculum content (public read) ─────────
    match /ageGroups/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /badges/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /programs/{programId} {
      allow read: if true;
      allow write: if isAdmin();

      // Nested course/module/lesson content
      match /{document=**} {
        allow read: if true;
        allow write: if isCoach();
      }
    }
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isCoach();
    }
    match /lessons/{lessonId} {
      allow read: if true;
      allow write: if isCoach();
    }
    match /resources/{resourceId} {
      allow read: if true;
      allow write: if isCoach();
    }
    match /quizzes/{quizId} {
      allow read: if true;
      allow write: if isCoach();
      match /{document=**} {
        allow read: if true;
        allow write: if isCoach();
      }
    }

    // ── User profiles ────────────────────────────────────────
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // Self-sign-up rules:
      //  • coaches create themselves as PENDING (admin must approve)
      //  • student accounts are created (via the coach's flow) as approved students
      //  • never an admin — admins are elevated via the console/Admin SDK
      allow create: if isOwner(uid) && (
                      (request.resource.data.role == 'coach' && request.resource.data.status == 'pending')
                      || request.resource.data.role == 'student'
                    );
      // Updates:
      //  • Admins can manage accounts, BUT changing anyone's ROLE (e.g.
      //    promoting to admin) is reserved for the ROOT admin (director),
      //    and the root account itself can never be changed by others.
      //  • A user can update their own profile but can NOT change their
      //    own role or approval status.
      allow update: if (isAdmin()
                        && (request.resource.data.role == resource.data.role || isRootAdmin())
                        && (resource.data.email != 'ebechalani@gmail.com' || isRootAdmin()))
                    || (isOwner(uid)
                        && request.resource.data.role == resource.data.role
                        && request.resource.data.get('status', 'approved') == resource.data.get('status', 'approved'));
      allow delete: if isAdmin();
    }

    // ── Coach classes ────────────────────────────────────────
    match /classes/{classId} {
      // Any signed-in user can read a class (students need their
      // class's assigned-lesson list; the doc holds nothing sensitive).
      allow read: if isSignedIn();
      allow create: if isCoach() && request.resource.data.coachId == request.auth.uid;
      allow update, delete: if isAdmin()
                    || (isCoach() && resource.data.coachId == request.auth.uid);

      // Roster (incl. student PINs): coach of this class + admin only;
      // a student may read their own entry.
      match /students/{sid} {
        allow read: if isAdmin() || isOwner(sid)
                    || (isSignedIn() && get(/databases/$(database)/documents/classes/$(classId)).data.coachId == request.auth.uid);
        allow write: if isAdmin()
                    || (isCoach() && get(/databases/$(database)/documents/classes/$(classId)).data.coachId == request.auth.uid);
      }

      // Daily attendance / roll call: coach of this class + admin only.
      match /attendance/{date} {
        allow read, write: if isAdmin()
                    || (isCoach() && get(/databases/$(database)/documents/classes/$(classId)).data.coachId == request.auth.uid);
      }
    }

    // ── Class groups ─────────────────────────────────────────
    match /groups/{groupId} {
      allow read: if isCoach() || isSignedIn();
      allow write: if isCoach();
    }

    // ── Student progress (owner + their coach + admin) ───────
    match /studentProgress/{docId} {
      allow read:  if isSignedIn() && (isOwner(resource.data.studentId) || isCoach());
      allow create: if isSignedIn() && isOwner(request.resource.data.studentId);
      allow update: if isCoach() || (isSignedIn() && isOwner(resource.data.studentId));
      allow delete: if isAdmin();
    }

    // ── Project submissions ──────────────────────────────────
    match /submissions/{docId} {
      allow read:   if isSignedIn() && (isOwner(resource.data.studentId) || isCoach());
      allow create: if isSignedIn() && isOwner(request.resource.data.studentId);
      allow update: if isCoach();   // coaches review / give feedback
      allow delete: if isAdmin();
    }

    // ── Earned badges ────────────────────────────────────────
    match /userBadges/{docId} {
      allow read:   if isSignedIn() && (isOwner(resource.data.studentId) || isCoach());
      allow write:  if isCoach();   // awarded by coaches / system
    }
  }
}
