# ─── Firebase (client SDK — safe to expose, these are public) ──
# From Firebase console → Project settings → General → "Your apps" → SDK config.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── Firebase Admin SDK (server only — SECRET, never expose) ───
# From Firebase console → Project settings → Service accounts →
# "Generate new private key". Use the values from that JSON file.
# For FIREBASE_PRIVATE_KEY, keep the literal \n escapes and wrap in quotes.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Copy this file to .env.local and fill in the values.
# In Vercel, add the same variables under Project → Settings → Environment Variables.
# (For seeding locally you can instead drop the service-account JSON at
#  scripts/serviceAccountKey.json — it is git-ignored.)
